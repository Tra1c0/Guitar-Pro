<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Only for the tuner; requested at runtime when the tuner is opened. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Zyklus 27: the only network use is the optional update check/download from GitHub (switchable in the settings). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Zyklus 27: hand a downloaded update to the system installer; Android asks the user every time. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application android:name=".RiffApplication" android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules" android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name" android:theme="@style/Theme.RiffWorkbench"
        android:supportsRtl="true"
        android:largeHeap="true">
        <!-- largeHeap: decoded reference audio is held as 16-bit PCM (up to ~115 MB for a 10-minute clip at 48 kHz). -->
        <activity android:name=".MainActivity" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
